# ========================================================
# TransitPulse Environment Variables Template
# Copy this file to '.env' and fill in your secrets.
# DO NOT commit your actual '.env' file to version control.
# ========================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production

# Backend Server Port (Local Development)
PORT=8000

# Optional API Security Key for Protected Endpoints
API_KEY=your_secure_api_key_here

# Frontend API Base URL (leave empty for relative Vercel routing, or set full URL)
VITE_API_BASE_URL=

# SQLite Database Path
DATABASE_URL=sqlite:///data/database.db
